# booklog web — Nginx 설정 템플릿
# 컨테이너가 시작할 때 이미지의 entrypoint가 ${...}를 환경 변수 값으로 바꿔 /etc/nginx/conf.d/default.conf를 만든다.
#   WAS_URL                was 주소 (Dockerfile 기본값 http://was:8000, compose · K8s Service 이름)
#   NGINX_LOCAL_RESOLVERS  컨테이너의 /etc/resolv.conf에 있는 DNS 서버 (Docker 내장 DNS, K8s CoreDNS)
# nginx 자체 변수($hostname, $uri 등)는 정의된 환경 변수가 아니라서 그대로 남는다.

server {
    listen 8080;                       # root가 아니라 1024 미만 포트를 열 수 없음 → 8080
    server_name _;
    root /usr/share/nginx/html;

    # 요청할 때마다 was 이름을 DNS로 조회 (10초 캐시) → web이 was보다 먼저 떠도, was IP가 바뀌어도 동작
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # 어느 web 컨테이너(Pod)가 응답했는지. 화면 하단이 이 헤더를 읽어 표시
    add_header X-Served-By $hostname always;

    # liveness: Nginx가 살아 있는지만 (파일 · was를 보지 않음)
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # JSON API → was. 변수로 쓰면 시작할 때가 아니라 요청할 때 주소를 조회한다
    location /api/ {
        set $was_upstream ${WAS_URL};
        proxy_pass $was_upstream;      # URI 없이 변수만 → 원래 요청 경로(/api/...)를 그대로 전달
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 화면: 빌드 결과물(dist). 해시 라우팅(#/books/3)이라 경로는 항상 / → index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
